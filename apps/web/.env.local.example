# Supabase (Project Settings → API) — same project as the dashboard app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by /api/leads and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# This app's public origin. Dashboard uses the same var to link here (e.g. /signup).
# Local: http://localhost:3000  Production: https://your-marketing-domain.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
