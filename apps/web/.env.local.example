# Supabase (Project Settings → API) — same project as the dashboard app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by /api/leads, /api/checkout, /api/track, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# This app's public origin. Dashboard uses the same var to link here (e.g. /signup).
# Local: http://localhost:3000  Production: https://your-marketing-domain.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# After cloning a storefront template onto a client site, set this to the
# seller's store_slug so that template loads products from Supabase.
# Leave empty on Ansaa template previews (dummy catalog).
# NEXT_PUBLIC_STORE_SLUG=

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
