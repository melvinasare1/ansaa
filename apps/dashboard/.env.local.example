# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Required for seller signup (insert
# seller row when email confirmation is on) and other admin API routes.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Marketing site origin — used by /login to link to /signup and by View store.
# Local: http://localhost:3000  Production: https://www.ansaagh.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Seller dashboard origin (marketing /login redirects here after a successful sign-in).
# Local: http://localhost:3001  Production: https://dashboard.ansaagh.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Namecheap affiliate link (Settings → Domain “buy a domain” CTA).
# Leave empty to hide the button. Example: https://namecheap.pxf.io/jRWzEP
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_URL=

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Ansaa MoMo for seller subscription payments (shown on /dashboard/billing).
ANSAA_MOMO_NUMBER=
ANSAA_MOMO_ACCOUNT_NAME=Ansaa

# Support tickets (Resend). FROM must be a verified Resend domain.
# Inbox is where seller tickets are delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ansaa Support <support@yourdomain.com>
SUPPORT_INBOX_EMAIL=you@yourdomain.com
