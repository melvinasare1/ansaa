# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Required for seller signup (insert
# seller row when email confirmation is on) and other admin API routes.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Marketing site origin — used by /login to link to /signup.
# Local: http://localhost:3000  Production: https://your-marketing-domain.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Support tickets (Resend). FROM must be a verified Resend domain.
# Inbox is where seller tickets are delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ansaa Support <support@yourdomain.com>
SUPPORT_INBOX_EMAIL=you@yourdomain.com
