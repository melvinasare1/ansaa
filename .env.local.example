# Copy this file to apps/web/.env.local and apps/dashboard/.env.local
# (both apps talk to the same Supabase project).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by API routes and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Marketing site origin — dashboard /login uses this to link to /signup.
# Local: http://localhost:3000  Production: https://your-marketing-domain.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Seller dashboard origin — marketing /login hands off the session here.
# Local: http://localhost:3001  Production: https://your-dashboard-domain.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Hubtel (payments) — fill in once you've confirmed rates
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Ansaa MoMo for seller subscription payments (dashboard /dashboard/billing).
ANSAA_MOMO_NUMBER=
ANSAA_MOMO_ACCOUNT_NAME=Ansaa

# Support tickets (dashboard only, Resend). FROM must be a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ansaa Support <support@yourdomain.com>
SUPPORT_INBOX_EMAIL=you@yourdomain.com
